[Unit]
Description=Gateway Auto-Mute Service
After=sound.target pulseaudio.service

[Service]
Type=simple
User=%i
WorkingDirectory=/home/stefan/.var/svc/gateway-auto-mute
ExecStart=/home/stefan/.var/svc/gateway-auto-mute/.venv/bin/python3 /home/stefan/.var/svc/gateway-auto-mute/service_manager.py start
ExecStop=/home/stefan/.var/svc/gateway-auto-mute/.venv/bin/python3 /home/stefan/.var/svc/gateway-auto-mute/service_manager.py stop
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
